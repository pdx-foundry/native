# Resolver lambda as a map search: {database}'s map (+0x58) is searched with {find}; a sentinel
# iterator selects the typed null object {null}. The result is stored through the captured
# destination, and the lambda returns the item's validity check.
stp xr0,xr1,[sp,#-0x20]!
stp x29,x30,[sp,#0x10]
add x29,sp,#0x10
mov xr1,x0
adrp xr2,PAGE
ldr xr2,[xr2,G] = {database}
ldr xr2,[xr2]
add x0,xr2,#0x58
bl CALL = {find}
ldrb wr2,[x0,#0x4]
add xr3,x0,#0x30
adrp xr4,PAGE
ldr xr4,[xr4,G] = {null}
cmp wr2,#0xff
csel xr2,xr4,xr3,eq
ldr x0,[xr2]
ldr xr2,[xr1,#0x8]
str x0,[xr2]
ldr xr2,[x0]
ldr x1,[xr2,#0x10]
ldp x29,x30,[sp,#0x10]
ldp xr0,xr1,[sp],#0x20
br x1
