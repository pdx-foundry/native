# {Owner}::PostInit() that skips an empty key string (this+{input}, length this+{input_length},
# flag byte this+{input_flag}), and otherwise searches the map of {database} (+0x58) with {find}.
# A sentinel iterator (state byte 0xff) selects the typed null object {null}; the item or the null
# object is stored at this+{output}.
stp xr0,xr1,[sp,#-0x20]!
stp x29,x30,[sp,#0x10]
add x29,sp,#0x10
mov xr1,x0
ldrsb wr2,[x0,#{input_flag}]
tbnz wr2,#0x1f,@+20
and xr2,xr2,#0xff
cbz xr2,@+15
add x1,xr1,#{input}
adrp xr2,PAGE
ldr xr2,[xr2,G] = {database}
ldr xr2,[xr2]
add x0,xr2,#0x58
bl CALL = {find}
ldrb wr2,[x0,#0x4]
add xr3,x0,#0x30
adrp xr4,PAGE
ldr xr4,[xr4,G] = {null}
cmp wr2,#0xff
csel xr2,xr4,xr3,eq
ldr xr2,[xr2]
str xr2,[xr1,#{output}]
ldp x29,x30,[sp,#0x10]
ldp xr0,xr1,[sp],#0x20
ret
ldr xr2,[xr1,#{input_length}]
cbnz xr2,@-18
b @-5
