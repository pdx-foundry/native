# Rust sources, manifests and the lockfile use LF on every checkout host.
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
# Packaged Python and generated wire bindings have byte identities across hosts.
src/**/*.py text eol=lf
# Compact answer baselines are generated; full diagnostic reports belong in .local/.
tests/population/**/*.json linguist-generated=true text eol=lf
